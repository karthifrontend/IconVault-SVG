# Copy this file to .env and fill in the values. Never commit .env.

# Required. MongoDB connection string. Use a dedicated database name (the part after the last "/")
# because the server creates/syncs indexes on the users, sprites and sprite_versions collections at startup.
MONGODB_URI=mongodb+srv://t12631879@gmail.com:uidev@123@cluster0.6a4cf0802fa4182921141007.mongodb.net/svg-compiler?retryWrites=true&w=majority

# Required. Secret used to sign session tokens. At least 16 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=fd5586ab1599a13efe331b64029a1c7cd91bf261c329636d7131ad8cae50f713

# Optional. Port for the API (default 5000).
PORT=http://localhost:5000

# Google sign-in (optional). OAuth "Web application" client id, same value as VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=

# Microsoft sign-in (optional). From the Entra ID app registration. Same values as the VITE_MS_* variables in client/.env.
MS_CLIENT_ID=
MS_TENANT_ID=

# Admins (optional but needed for admin features). Comma-separated emails; matching is case-insensitive.
# An email only counts if the sign-in provider verified it (always true for Google). For Microsoft work
# accounts it counts only when MS_TENANT_ID is your own tenant id (not "common"). Read on every request,
# so edit and restart to change admins. Nothing is stored in the database.
ADMIN_EMAILS=
